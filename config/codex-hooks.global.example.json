{
  "description": "Optional global capture for Codex work outside the Ledger repository.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/changxi/Coding/Ledger/hooks/capture_interaction.py --include-content --output \"$HOME/.local/share/ledger/interactions.jsonl\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/changxi/Coding/Ledger/hooks/capture_interaction.py --include-content --output \"$HOME/.local/share/ledger/interactions.jsonl\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/changxi/Coding/Ledger/hooks/capture_interaction.py --output \"$HOME/.local/share/ledger/interactions.jsonl\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/changxi/Coding/Ledger/hooks/capture_interaction.py --output \"$HOME/.local/share/ledger/interactions.jsonl\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}

