{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledger.local/schemas/weekly-input.schema.json",
  "title": "Ledger reviewed weekly input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "week",
    "period",
    "target_focus_hours",
    "actual_focus_hours",
    "tasks",
    "themes",
    "source_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "period": { "$ref": "#/$defs/period" },
    "target_focus_hours": { "type": ["number", "null"], "minimum": 0 },
    "actual_focus_hours": { "type": ["number", "null"], "minimum": 0 },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/theme" }
    },
    "reflection": {
      "type": "array",
      "items": { "$ref": "#/$defs/reflection" }
    },
    "next_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/planned_task" }
        }
      }
    },
    "source_status": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_status" }
    },
    "evidence_file": { "type": "string", "minLength": 1 },
    "evidence_review_file": { "type": "string", "minLength": 1 },
    "plan_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "task": {
      "type": "object",
      "required": ["title", "completed"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "title": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "completed": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "status": {},
        "cycle": {},
        "updated_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "planned_task": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "title": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "type": "string" }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "weight",
        "progress",
        "evidence_count",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "public_name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "source", "reason"],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "git_commit",
            "git_worktree",
            "interaction",
            "linear_issue",
            "calendar_event"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "event_id": { "type": ["string", "integer"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "event_type": { "const": "git_commit" } } },
          "then": { "required": ["commit", "path"] }
        },
        {
          "if": { "properties": { "event_type": { "const": "git_worktree" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": ["interaction", "linear_issue", "calendar_event"]
              }
            }
          },
          "then": { "required": ["event_id"] }
        }
      ]
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "evidence", "why_it_matters", "suggestion"],
      "properties": {
        "issue": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 }
      }
    },
    "source_status": {
      "type": "object",
      "required": ["name", "category", "required", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["available", "disabled", "error", "stale", "unavailable"]
        }
      },
      "additionalProperties": true
    }
  }
}
